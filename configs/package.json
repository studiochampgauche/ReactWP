{
  "name": "reactwp-tooling",
  "version": "3.0.0",
  "private": true,
  "description": "ReactWP v3 build tooling",
  "license": "GPL-2.0-or-later",
  "homepage": "https://reactwp.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiochampgauche/ReactWP.git"
  },
  "bugs": {
    "url": "https://github.com/studiochampgauche/ReactWP/issues"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "build": "node ./scripts/project-pipeline.mjs build",
    "build:themes": "node ./scripts/theme-pipeline.mjs build",
    "build:themes:js": "webpack --mode development --config webpack.themes.config.js",
    "build:themes:css": "node ./scripts/build-theme-styles.mjs build",
    "build:render": "webpack --mode development --config webpack.render.config.js",
    "build:plugins": "webpack --mode development --config webpack.plugins.config.js",
    "build:mu-plugins": "webpack --mode development --config webpack.mu-plugins.config.js",
    "watch": "node ./scripts/project-pipeline.mjs watch",
    "watch:themes": "node ./scripts/theme-pipeline.mjs watch",
    "watch:themes:js": "webpack --mode development --config webpack.themes.config.js --watch",
    "watch:themes:css": "node ./scripts/build-theme-styles.mjs watch",
    "watch:render": "webpack --mode development --config webpack.render.config.js --watch",
    "watch:plugins": "webpack --mode development --config webpack.plugins.config.js --watch",
    "watch:mu-plugins": "webpack --mode development --config webpack.mu-plugins.config.js --watch",
    "prod": "node ./scripts/project-pipeline.mjs prod",
    "prod:themes": "node ./scripts/theme-pipeline.mjs prod",
    "prod:themes:js": "webpack --mode production --config webpack.themes.config.js",
    "prod:themes:css": "node ./scripts/build-theme-styles.mjs prod",
    "prod:render": "webpack --mode production --config webpack.render.config.js",
    "generate": "node ./scripts/generate-static.mjs",
    "serve:ssr": "node ../dist/wp-content/themes/reactwp/assets/render/serve.mjs",
    "test:render": "npm run build:render && node --test ./tests/rendering.test.mjs",
    "test:rest-access": "node ./scripts/run-php-tests.mjs ./tests/rest-access.test.php",
    "test:headless-api-security": "node ./scripts/run-php-tests.mjs ./tests/headless-api-security.test.php",
    "test:route-visibility": "node ./scripts/run-php-tests.mjs ./tests/route-visibility.test.php",
    "test:public-payload": "node ./scripts/run-php-tests.mjs ./tests/public-payload.test.php",
    "test:preview-token": "node ./scripts/run-php-tests.mjs ./tests/preview-token.test.php",
    "test:svg-sanitizer": "node ./scripts/run-php-tests.mjs ./tests/svg-sanitizer.test.php",
    "test:render-cache": "node ./scripts/run-php-tests.mjs ./tests/render-cache.test.php",
    "test:server-security": "node ./scripts/run-php-tests.mjs ./tests/server-renderer-security.test.php",
    "test:static-regenerator": "node ./scripts/run-php-tests.mjs ./tests/static-regenerator.test.php",
    "test:firstload": "node ./scripts/run-php-tests.mjs ./tests/firstload.test.php",
    "test:security": "node ./scripts/run-php-tests.mjs && node --test ./tests/get-core-security.test.mjs",
    "report:themes": "node ./scripts/report-bundle-sizes.mjs",
    "prod:plugins": "webpack --mode production --config webpack.plugins.config.js",
    "prod:mu-plugins": "webpack --mode production --config webpack.mu-plugins.config.js",
    "get:core": "node ./scripts/get-core.mjs"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-react": "8.0.1",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.4",
    "gsap": "3.15.0",
    "html-react-parser": "6.1.5",
    "image-minimizer-webpack-plugin": "5.0.0",
    "mini-css-extract-plugin": "2.10.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "sass": "1.102.0",
    "sass-loader": "17.0.0",
    "sharp": "0.35.3",
    "style-loader": "4.0.0",
    "svgo": "4.1.0",
    "terser-webpack-plugin": "5.6.1",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true
  }
}
